{
  "name": "agentr",
  "version": "0.1.0",
  "description": "MCP server for interactive R sessions — works with Claude Code and OpenCode",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "agentr": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "ssh2": "^1.16.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ssh2": "^1.15.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": ["mcp", "r", "rstudio", "claude-code", "opencode", "ssh"],
  "license": "MIT"
}
